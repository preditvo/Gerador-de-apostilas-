    /********************************************************************
     * 3. MULTIMODAL FILE UPLOAD HANDLER (.txt, .md, .json, .csv, .png, .jpg, .pdf)
     ********************************************************************/
    function setupDragAndDrop() {
      const dropzone = document.getElementById('file-dropzone');
      if (!dropzone) return;

      ['dragenter', 'dragover'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('border-brand-600', 'bg-brand-50/60');
        });
      });

      ['dragleave', 'drop'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('border-brand-600', 'bg-brand-50/60');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        if (e.dataTransfer?.files?.length) {
          handleFilesSelected(e.dataTransfer.files);
        }
      });
    }

    async function handleFilesSelected(fileList) {
      if (!fileList || fileList.length === 0) return;

      for (const file of Array.from(fileList)) {
        const ext = file.name.split('.').pop().toLowerCase();
        const isTextFile = ['txt', 'md', 'json', 'csv'].includes(ext);
        const isBinarySupported = ['png', 'jpg', 'jpeg', 'webp', 'pdf'].includes(ext);

        if (!isTextFile && !isBinarySupported) {
          showToast(`Formato não suportado (${file.name}). Use .txt, .md, .json, .csv, .png, .jpg ou .pdf.`, 'warning');
          continue;
        }

        try {
          if (isTextFile) {
            const textContent = await readFileAsText(file);
            attachedFiles.push({
              id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()),
              name: file.name,
              size: formatBytes(file.size),
              mimeType: file.type || 'text/plain',
              isText: true,
              content: textContent
            });
          } else {
            const base64Data = await readFileAsBase64(file);
            let mimeType = file.type;
            if (!mimeType) {
              if (ext === 'pdf') mimeType = 'application/pdf';
              else if (ext === 'png') mimeType = 'image/png';
              else mimeType = 'image/jpeg';
            }
            attachedFiles.push({
              id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()),
              name: file.name,
              size: formatBytes(file.size),
              mimeType: mimeType,
              isText: false,
              base64Data: base64Data
            });
          }
        } catch (err) {
          console.error("Erro ao processar arquivo:", err);
          showToast(`Não foi possível ler o arquivo ${file.name}.`, 'error');
        }
      }

      document.getElementById('file-input').value = '';
      renderAttachedFilesList();
      showToast(`${fileList.length} arquivo(s) anexado(s) para o prompt multimodal do Gemini.`, 'success');
    }

    function readFileAsText(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsText(file);
      });
    }

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = String(reader.result);
          const base64Clean = result.includes(',') ? result.split(',')[1] : result;
          resolve(base64Clean);
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function removeAttachedFile(id) {
      attachedFiles = attachedFiles.filter(f => f.id !== id);
      renderAttachedFilesList();
