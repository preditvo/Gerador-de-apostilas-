              <span class="font-mono text-xs font-bold uppercase tracking-widest text-teal-700 block mb-1">
                VERIFICAÇÃO DE APRENDIZAGEM E PRÁTICA PROFISSIONAL
              </span>
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight" contenteditable="true">
                Caderno de Exercícios e Gabarito Comentado
              </h2>
            </div>

            <!-- Questions & Answers List -->
            <div>
              ${allQuestionsHtml}
            </div>

            <!-- Web Grounding Citations -->
            ${sourcesHtml}
          </div>

          <!-- Sheet Footer -->
          <div class="pt-5 border-t border-slate-200 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>Caderno de Exercícios e Gabarito Oficial</span>
            <span>Pág. ${wb.capitulos.length + 2}</span>
          </div>
        </article>
      `;

      root.innerHTML = html;
    }

    function buildChapterFigureInnerHtml(chapterIdx) {
      const cap = currentWorkbook.capitulos[chapterIdx];
      if (!cap) return '';

      let visualBody = '';

      if (cap.gerando_imagem) {
        visualBody = `
          <div class="w-full h-64 rounded-lg bg-slate-100 border border-slate-200 flex flex-col items-center justify-center p-6 text-center animate-pulse">
            <div class="w-10 h-10 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center mb-3">
              <i class="ph ph-spinner animate-spin text-xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-700">Gerando Ilustração Técnica com IA para o Capítulo ${chapterIdx + 1}...</p>
            <p class="text-[11px] font-mono text-slate-500 mt-1 max-w-md truncate">${escapeHtml(cap.prompt_imagem)}</p>
          </div>
        `;
      } else if (cap.imagem_url) {
        const engineBadge = cap.motor_imagem
          ? `<span class="no-print absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-slate-900/80 text-white backdrop-blur-sm shadow">${escapeHtml(cap.motor_imagem)}</span>`
          : '';
        visualBody = `
          <div class="relative w-full overflow-hidden rounded-lg border border-slate-200 bg-white flex items-center justify-center">
            ${engineBadge}
            <img
              src="${cap.imagem_url}"
              alt="${escapeAttr(cap.legenda_imagem)}"
              class="max-h-[310px] w-auto object-contain mx-auto"
            />
          </div>
        `;
      } else {
        // Technical Blueprint SVG Placeholder when no AI image has been generated yet
        visualBody = `
          <div class="w-full py-9 px-6 rounded-lg bg-slate-50 border border-dashed border-slate-300 flex flex-col items-center justify-center text-center">
            <svg class="w-14 h-14 text-slate-400 mb-2" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="8" y="12" width="48" height="40" rx="4" stroke-dasharray="4 3"/>
              <circle cx="24" cy="28" r="5"/>
              <path d="M14 46L26 35L35 43L44 31L52 46"/>
            </svg>
            <p class="text-xs font-semibold text-slate-700">Espaço Reservado para Figura / Diagrama do Capítulo ${chapterIdx + 1}</p>
            <p class="text-[11px] text-slate-500 max-w-md mt-0.5">
              Clique em <strong>"Gerar / Regenerar Imagem IA"</strong> abaixo ou faça <strong>"Upload de Imagem Própria"</strong> (diagrama, foto de bancada ou esquema técnico).
            </p>
          </div>
        `;
      }

      return `
        <figure class="rounded-xl border border-slate-200 bg-slate-50/50 p-3.5">
          ${visualBody}

          <figcaption
            class="mt-2.5 text-center text-xs font-mono text-slate-600"
            contenteditable="true"
            onblur="currentWorkbook.capitulos[${chapterIdx}].legenda_imagem = this.innerText"
          >${escapeHtml(cap.legenda_imagem || `Figura ${chapterIdx + 1}.1 — Ilustração técnica do capítulo.`)}</figcaption>

          <!-- Interactive Figure Action Bar (Hidden on Print / PDF) -->
          <div class="no-print mt-3 pt-2.5 border-t border-slate-200/80 flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-1.5">
              <button
                onclick="generateChapterImage(${chapterIdx})"
                ${cap.gerando_imagem ? 'disabled' : ''}
                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-brand-600 text-white hover:bg-brand-700 disabled:opacity-50 transition shadow-sm"
              >
                <i class="ph ph-arrows-clockwise ${cap.gerando_imagem ? 'animate-spin' : ''}"></i>
                <span>${cap.imagem_url ? 'Regenerar Imagem IA' : 'Gerar Imagem IA'}</span>
              </button>

              <button
                onclick="triggerChapterCustomImageUpload(${chapterIdx})"
                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-white text-slate-700 border border-slate-300 hover:bg-slate-100 transition"
              >
                <i class="ph ph-upload-simple text-teal-600"></i>
                <span>Upload de Imagem Própria</span>
              </button>
            </div>

            <button
              onclick="togglePromptEditor(${chapterIdx})"
              class="text-[11px] font-mono text-slate-500 hover:text-brand-700 inline-flex items-center gap-1"
            >
              <i class="ph ph-Sliders"></i> Editar Prompt IA
            </button>
          </div>

          <!-- Collapsible Prompt Editor per Chapter -->
          <div id="prompt-editor-box-${chapterIdx}" class="no-print hidden mt-2.5 pt-2 border-t border-slate-200">
            <label class="block text-[10px] font-mono uppercase text-slate-500 mb-1">Prompt da Ilustração (Inglês ou Português):</label>
            <div class="flex gap-1.5">
              <input
                id="chapter-prompt-input-${chapterIdx}"
                type="text"
                value="${escapeAttr(cap.prompt_imagem)}"
                onchange="currentWorkbook.capitulos[${chapterIdx}].prompt_imagem = this.value"
                class="flex-1 px-2.5 py-1 text-xs font-mono rounded border border-slate-300 bg-white text-slate-800"
              />
              <button
                onclick="generateChapterImage(${chapterIdx})"
                class="px-3 py-1 rounded bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800"
              >
                Aplicar
              </button>
            </div>
          </div>
        </figure>
      `;
    }

    function updateChapterFigureDOM(chapterIdx) {
      const container = document.getElementById(`chapter-figure-container-${chapterIdx}`);
      if (container) {
        container.innerHTML = buildChapterFigureInnerHtml(chapterIdx);
      }
    }

    /********************************************************************
     * 8. INLINE CONTENTEDITABLE SYNCHRONIZATION & MANUAL CHAPTER CONTROLS
     ********************************************************************/
    function syncChapterTitle(idx, newText) {
      if (!currentWorkbook.capitulos[idx]) return;
      // Strip leading "1. " if present
      const cleaned = newText.replace(/^\d+\.\s*/, '').trim();
      currentWorkbook.capitulos[idx].titulo = cleaned || currentWorkbook.capitulos[idx].titulo;
    }

    function syncChapterParagraph(cIdx, pIdx, newText) {
      if (currentWorkbook.capitulos[cIdx]?.conteudo) {
        currentWorkbook.capitulos[cIdx].conteudo[pIdx] = newText;
      }
    }

    function addNewBlankChapter() {
      const nextNum = currentWorkbook.capitulos.length + 1;
      currentWorkbook.capitulos.push({
        titulo: `Novo Tópico Técnico ${nextNum}`,
        conteudo: [
          "Clique neste parágrafo para redigir ou colar o conteúdo técnico deste módulo. Todos os textos desta apostila possuem suporte a edição direta na folha A4.",
          "Adicione explicações detalhadas, parâmetros operacionais, fórmulas e procedimentos práticos de bancada ou campo."
        ],
        quadro_destaque: "DICA TÉCNICA: Destaque aqui uma norma regulamentadora (NR/ABNT) ou recomendação prática de segurança.",
        prompt_imagem: "Clean technical educational diagram blueprint style on white background",
        imagem_url: null,
        gerando_imagem: false,
        legenda_imagem: `Figura ${nextNum}.1 — Diagrama explicativo do módulo ${nextNum}.`,
        questoes: [
          {
            pergunta: "Questão de fixação referente ao novo módulo técnico adicionado.",
            gabarito: "Gabarito comentado explicando os critérios técnicos da resposta esperada."
          }
        ]
      });
      renderWorkbookA4();
      showToast(`Capítulo ${nextNum} adicionado! Role a página para editá-lo.`, "success");
    }

    function removeChapter(idx) {
      if (currentWorkbook.capitulos.length <= 1) {
        showToast("A apostila deve conter pelo menos 1 capítulo.", "warning");
        return;
      }
      currentWorkbook.capitulos.splice(idx, 1);
      renderWorkbookA4();
      showToast("Capítulo removido da apostila.", "info");
    }

    /********************************************************************
     * 9. PDF EXPORT ENGINES (html2pdf.js & Native High-Res @media print)
     ********************************************************************/
    async function exportHtml2Pdf() {
      const element = document.getElementById('workbook-a4-root');
      const btn = document.getElementById('btn-html2pdf');
      if (!element) return;

      // Hide all .no-print elements inside the A4 container temporarily so html2pdf doesn't render chapter action buttons
      const internalNoPrintEls = element.querySelectorAll('.no-print');
      internalNoPrintEls.forEach(el => el.classList.add('!hidden'));

      // Temporarily adjust sheet shadow/margin for clean A4 capture
      const sheets = element.querySelectorAll('.a4-sheet');
      sheets.forEach(s => {
        s.style.boxShadow = 'none';
        s.style.marginBottom = '0';
      });

      const originalBtnHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<i class="ph ph-spinner animate-spin text-base text-rose-600"></i> <span>Renderizando PDF...</span>`;
      showToast("Gerando arquivo PDF A4 via html2pdf... Aguarde alguns instantes.", "info");

      const safeFilename = (currentWorkbook.titulo || 'apostila-tecnica')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '') + '.pdf';

      const opt = {
        margin: [0, 0, 0, 0],
        filename: safeFilename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: {
          scale: 2,
          useCORS: true,
          letterRendering: true,
          scrollY: 0
        },
        jsPDF: {
          unit: 'mm',
          format: 'a4',
          orientation: 'portrait'
        },
        pagebreak: {
          mode: ['css', 'legacy'],
          avoid: ['.avoid-break']
        }
      };

      try {
        await html2pdf().set(opt).from(element).save();
        showToast("Download do PDF concluído com sucesso!", "success");
      } catch (err) {
        console.error("Erro no html2pdf:", err);
        showToast("Houve um erro ao gerar via html2pdf. Recomendamos clicar em 'Salvar PDF Nativo (Alta Resolução)'.", "warning");
      } finally {
        internalNoPrintEls.forEach(el => el.classList.remove('!hidden'));
        sheets.forEach(s => {
          s.style.boxShadow = '';
          s.style.marginBottom = '';
        });
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }

    function triggerNativePrint() {
      window.print();
    }

    /********************************************************************
     * 10. UI HELPERS (MOBILE DRAWER, TOAST, ESCAPING)
     ********************************************************************/
    function toggleMobileSidebar(forceState) {
      const sidebar = document.getElementById('config-sidebar');
      if (!sidebar) return;
      const isClosed = sidebar.classList.contains('-translate-x-full');
      const shouldOpen = typeof forceState === 'boolean' ? forceState : isClosed;
      if (shouldOpen) {
        sidebar.classList.remove('-translate-x-full');
      } else {
        sidebar.classList.add('-translate-x-full');
      }
    }

    let toastTimeout = null;
    function showToast(message, type = 'success') {
      const toast = document.getElementById('toast-notification');
      const icon = document.getElementById('toast-icon');
      const msg = document.getElementById('toast-message');

      msg.textContent = message;
      icon.className = 'ph-fill text-xl shrink-0 ';
      if (type === 'error') icon.classList.add('ph-warning-octagon', 'text-rose-400');
      else if (type === 'warning') icon.classList.add('ph-warning', 'text-amber-400');
      else if (type === 'info') icon.classList.add('ph-info', 'text-sky-400');
      else icon.classList.add('ph-check-circle', 'text-emerald-400');

      toast.classList.remove('hidden');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(hideToast, 5500);
    }

    function hideToast() {
      const toast = document.getElementById('toast-notification');
      if (toast) toast.classList.add('hidden');
    }

    function formatBytes(bytes) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function escapeAttr(str) {
      return escapeHtml(str);
    }

    // Initialize on load
    window.addEventListener('DOMContentLoaded', () => {
      initApiKeyManagerUI();
      setupDragAndDrop();
      renderWorkbookA4();
    });
  </script>
