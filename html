    /********************************************************************
     * 5. GEMINI API INTEGRATION (TEXT + MULTIMODAL + SEARCH GROUNDING + IMAGE GEN)
     ********************************************************************/
    async function fetchWithRetry(url, options, maxRetries = 4) {
      let delay = 1000;
      for (let attempt = 0; attempt < maxRetries; attempt++) {
        try {
          const response = await fetch(url, options);
          if (response.ok) {
            return await response.json();
          }
          // If 400 Bad Request, return JSON error immediately so caller can inspect/fallback
          if (response.status === 400) {
            const errBody = await response.json().catch(() => ({}));
            const err = new Error(errBody?.error?.message || `HTTP 400`);
            err.status = 400;
            throw err;
          }
          if (attempt === maxRetries - 1) {
            const errBody = await response.json().catch(() => ({}));
            throw new Error(errBody?.error?.message || `Erro HTTP ${response.status}`);
          }
        } catch (err) {
          if (err.status === 400 || attempt === maxRetries - 1) throw err;
        }
        await new Promise(r => setTimeout(r, delay));
        delay *= 2;
      }
    }

