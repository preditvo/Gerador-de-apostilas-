    async function requestHybridAIImageGeneration(promptText, engineMode, cap, chapterIdx) {
      const activeKey = getEffectiveApiKey();

      // 1. Try Google Imagen 3 / Gemini Image API if mode is 'auto' or 'imagen'
      if (engineMode === 'auto' || engineMode === 'imagen') {
        try {
          const googleImg = await tryGoogleImageEndpoints(promptText, activeKey);
          if (googleImg) {
            return { dataUrl: googleImg, engineLabel: "Google Imagen 3 / Gemini IA" };
          }
        } catch (googleErr) {
          console.warn("Google Imagen/Gemini Image indisponível ou chave sem Billing. Acionando fallback se permitido:", googleErr.message);
          if (engineMode === 'imagen') {
            throw googleErr;
          }
        }
      }

      // 2. Free AI Engine (Pollinations Flux/Turbo converted to Base64 Data URL for CORS-free html2pdf export)
      try {
        const freeBase64Url = await fetchFreePollinationsImageAsBase64(promptText, chapterIdx);
        return { dataUrl: freeBase64Url, engineLabel: "IA Gratuita (Flux Base64)" };
      } catch (freeErr) {
        console.warn("Fallback gratuito Pollinations falhou ou bloqueado por rede, gerando Diagrama Técnico SVG:", freeErr);
        return {
          dataUrl: generateTechnicalBlueprintSvgDataUrl(cap, chapterIdx),
          engineLabel: "Diagrama Técnico SVG"
        };
      }
    }

    async function tryGoogleImageEndpoints(promptText, activeKey) {
      // Attempt 1: Official Imagen 3 predict endpoint (imagen-3.0-generate-002)
      const imagenUrl = `https://generativelanguage.googleapis.com/v1beta/models/imagen-3.0-generate-002:predict?key=${activeKey}`;
      try {
        const imagenRes = await fetchWithRetry(imagenUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            instances: [{ prompt: promptText }],
            parameters: { sampleCount: 1, aspectRatio: "16:9" }
          })
        }, 2);
        const b64Imagen = imagenRes?.predictions?.[0]?.bytesBase64Encoded;
        if (b64Imagen) {
          const mime = imagenRes?.predictions?.[0]?.mimeType || 'image/png';
          return `data:${mime};base64,${b64Imagen}`;
        }
      } catch (e) {
        // Proceed to Gemini Flash Image endpoint
      }

      // Attempt 2: gemini-3.1-flash-image generateContent endpoint
      const flashImageUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${activeKey}`;
      try {
        const res = await fetchWithRetry(flashImageUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ role: 'user', parts: [{ text: promptText }] }],
            generationConfig: {
              responseModalities: ['IMAGE'],
              imageConfig: { aspectRatio: "16:9" }
            }
          })
        }, 2);
        const part = res?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
        if (part?.inlineData?.data) {
          return `data:${part.inlineData.mimeType || 'image/png'};base64,${part.inlineData.data}`;
        }
      } catch (e) {
        // Proceed to lite image endpoint
      }

      // Attempt 3: gemini-3.1-flash-lite-image
      const liteImageUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-image:generateContent?key=${activeKey}`;
      const resLite = await fetchWithRetry(liteImageUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: promptText }] }],
          generationConfig: { responseModalities: ['TEXT', 'IMAGE'] }
        })
      }, 2);
      const partLite = resLite?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
      if (partLite?.inlineData?.data) {
        return `data:${partLite.inlineData.mimeType || 'image/png'};base64,${partLite.inlineData.data}`;
      }

      throw new Error("Endpoints de imagem Google exigem Billing ou não retornaram imagem.");
    }

    async function fetchFreePollinationsImageAsBase64(promptText, chapterIdx = 0) {
      const seed = Math.floor(1000 + Math.random() * 900000) + chapterIdx * 17;
      const cleanPrompt = promptText.slice(0, 380);
      const url = `https://image.pollinations.ai/prompt/${encodeURIComponent(cleanPrompt)}?width=1024&height=576&nologo=true&seed=${seed}&model=flux`;

      // Method A: Fetch as Blob and convert via FileReader to Base64 Data URL
      try {
        const response = await fetch(url, { mode: 'cors', cache: 'no-store' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const blob = await response.blob();
        return await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      } catch (fetchErr) {
        // Method B: Offscreen Image with crossOrigin="anonymous" drawn to Canvas -> toDataURL
        return await new Promise((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          const timeoutId = setTimeout(() => {
            reject(new Error("Tempo limite excedido ao carregar imagem gratuita."));
          }, 18000);

          img.onload = () => {
            clearTimeout(timeoutId);
            try {
              const canvas = document.createElement('canvas');
              canvas.width = img.naturalWidth || 1024;
              canvas.height = img.naturalHeight || 576;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0);
              const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
              resolve(dataUrl);
            } catch (canvasErr) {
              reject(canvasErr);
            }
          };
          img.onerror = (err) => {
            clearTimeout(timeoutId);
            reject(err);
          };
          img.src = url;
        });
      }
    }

